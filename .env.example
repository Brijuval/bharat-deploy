# BharatDeploy Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ---------------------------------------------------------------
# Groq API (required for natural language processing)
# Get your key at: https://console.groq.com
# ---------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use (default: llama3-8b-8192)
GROQ_MODEL=llama3-8b-8192

# ---------------------------------------------------------------
# AWS Credentials (required for deployment)
# Configure via `aws configure` or set below
# ---------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-south-1

# ---------------------------------------------------------------
# BharatDeploy Settings
# ---------------------------------------------------------------
# Default language: hi (Hindi), en (English), hinglish
BHARAT_DEFAULT_LANGUAGE=hi

# Log level: DEBUG, INFO, WARNING, ERROR
BHARAT_LOG_LEVEL=INFO

# Dry-run mode: execute commands without making real changes
BHARAT_DRY_RUN=false
