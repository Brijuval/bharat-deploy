# BharatDeploy Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================================
# REQUIRED: Groq API Key
# Get your free key at: https://console.groq.com
# ============================================================
GROQ_API_KEY=your_groq_api_key_here

# ============================================================
# AWS Configuration
# ============================================================
# AWS Region (default: ap-south-1 = Mumbai)
AWS_DEFAULT_REGION=ap-south-1

# AWS Credentials (or use 'aws configure' CLI)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# ============================================================
# BharatDeploy Settings
# ============================================================
# Default language: auto/hi/ta/kn/en/hinglish
BHARAT_LANGUAGE=auto

# Dry run mode (true = show commands but don't execute)
BHARAT_DRY_RUN=false

# Verbose logging
BHARAT_VERBOSE=false

# Groq model (default: llama3-8b-8192)
# Options: llama3-8b-8192, llama3-70b-8192, mixtral-8x7b-32768
BHARAT_GROQ_MODEL=llama3-8b-8192
